from flask import Flask, jsonify, render_template, Response
from pathlib import Path
import csv
import json
import subprocess
import time

BASE_DIR = Path(__file__).resolve().parent.parent
DATA_DIR = BASE_DIR / "data"

LIVE_METRICS = DATA_DIR / "live_network_metrics.csv"
LIVE_FEATURES = DATA_DIR / "live_features.csv"
CONTROLLED = DATA_DIR / "controlled_experiments.csv"
CONTROLLER_STATE = DATA_DIR / "controller_state.json"
CONTROLLER_EVENTS = DATA_DIR / "controller_events.jsonl"

app = Flask(
    __name__,
    template_folder=str(BASE_DIR / "dashboard" / "templates")
)


def read_csv_file(path, limit=None):
    if not path.exists():
        return []

    try:
        with path.open("r", encoding="utf-8", errors="replace") as f:
            rows = list(csv.DictReader(f))

        if limit is not None:
            return rows[-limit:]

        return rows

    except Exception:
        return []


def read_json_file(path):
    if not path.exists():
        return {}

    try:
        with path.open("r", encoding="utf-8", errors="replace") as f:
            return json.load(f)

    except Exception:
        return {}


def safe_float(value, default=0.0):
    try:
        if value is None or value == "":
            return default
        return float(value)
    except Exception:
        return default


def latest_row():
    features = read_csv_file(LIVE_FEATURES)

    if features:
        return features[-1]

    metrics = read_csv_file(LIVE_METRICS)

    if metrics:
        return metrics[-1]

    return {}


def get_controller_state():
    state = read_json_file(CONTROLLER_STATE)

    if isinstance(state, dict):
        return state

    return {}


def infer_state(row):
    latency = safe_float(row.get("latency_ms"))
    jitter = safe_float(row.get("jitter_ms"))
    loss = safe_float(row.get("packet_loss_percent"))
    traffic = safe_float(row.get("total_traffic_mbps"))

    if (
        traffic >= 20
        or latency >= 40
        or jitter >= 20
        or loss >= 5
    ):
        return "CONGESTED"

    if (
        traffic >= 10
        or latency >= 20
        or jitter >= 10
        or loss >= 1
    ):
        return "WARNING"

    return "NORMAL"


def read_tc():
    commands = [
        ["tc", "qdisc", "show", "dev", "eth0"],
        ["tc", "class", "show", "dev", "eth0"],
    ]

    output = []

    for command in commands:
        try:
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=2
            )

            if result.stdout:
                output.append(result.stdout.strip())

        except Exception:
            pass

    if output:
        return "\n".join(output)

    try:
        result = subprocess.run(
            ["sudo", "-n", "tc", "qdisc", "show", "dev", "eth0"],
            capture_output=True,
            text=True,
            timeout=2
        )

        if result.stdout:
            return result.stdout.strip()

    except Exception:
        pass

    return "Traffic-control information is currently unavailable."


@app.route("/")
def index():
    return render_template("dashboard.html")


@app.route("/api/metrics")
def api_metrics():
    row = latest_row()
    controller = get_controller_state()

    validated_state = (
        controller.get("validated_state")
        or controller.get("state")
        or controller.get("status")
        or infer_state(row)
    )

    prediction = (
        controller.get("ml_prediction")
        or controller.get("prediction")
        or validated_state
    )

    policy = controller.get("policy", {})

    return jsonify({
        "timestamp": row.get("timestamp"),
        "interface": row.get("interface", "eth0"),

        "rx_mbps": safe_float(row.get("rx_mbps")),
        "tx_mbps": safe_float(row.get("tx_mbps")),
        "total_traffic_mbps": safe_float(
            row.get("total_traffic_mbps"),
            safe_float(row.get("rx_mbps")) + safe_float(row.get("tx_mbps"))
        ),

        "latency_ms": safe_float(row.get("latency_ms")),
        "jitter_ms": safe_float(row.get("jitter_ms")),
        "packet_loss_percent": safe_float(
            row.get("packet_loss_percent")
        ),

        "signal_percent": safe_float(row.get("signal_percent")),
        "rssi_dbm": safe_float(row.get("rssi_dbm")),

        "validated_state": str(validated_state).upper(),
        "ml_prediction": str(prediction).upper(),
        "reason": controller.get(
            "reason",
            "Network state derived from current telemetry."
        ),

        "congestion_score": safe_float(
            controller.get("congestion_score")
        ),

        "policy": policy,

        "controller_available": bool(controller),

        "data_available": bool(row)
    })


@app.route("/api/history")
def api_history():
    rows = read_csv_file(LIVE_METRICS, limit=120)

    if not rows:
        rows = read_csv_file(LIVE_FEATURES, limit=120)

    return jsonify(rows)


@app.route("/api/events")
def api_events():
    if not CONTROLLER_EVENTS.exists():
        return jsonify([])

    events = []

    try:
        with CONTROLLER_EVENTS.open(
            "r",
            encoding="utf-8",
            errors="replace"
        ) as f:

            for line in f.readlines()[-50:]:
                line = line.strip()

                if not line:
                    continue

                try:
                    events.append(json.loads(line))
                except Exception:
                    continue

    except Exception:
        pass

    return jsonify(events)


@app.route("/api/tc")
def api_tc():
    output = read_tc()

    return jsonify({
        "available": (
            "unavailable" not in output.lower()
            and "currently unavailable" not in output.lower()
        ),
        "output": output
    })


@app.route("/api/experiments")
def api_experiments():
    return jsonify(
        read_csv_file(CONTROLLED)
    )


@app.route("/api/health")
def api_health():
    metrics_exists = LIVE_METRICS.exists()
    features_exists = LIVE_FEATURES.exists()
    controller_exists = CONTROLLER_STATE.exists()

    return jsonify({
        "status": "ONLINE",
        "dashboard": True,
        "live_metrics_file": metrics_exists,
        "live_features_file": features_exists,
        "controller_state_file": controller_exists,
        "timestamp": time.time()
    })


@app.route("/api/export/csv")
def api_export_csv():
    rows = read_csv_file(LIVE_METRICS)

    if not rows:
        return Response(
            "No live metrics available.\n",
            mimetype="text/plain"
        )

    fields = list(rows[0].keys())

    output = []

    output.append(",".join(fields))

    for row in rows:
        output.append(
            ",".join(
                str(row.get(field, "")).replace(",", ";")
                for field in fields
            )
        )

    return Response(
        "\n".join(output),
        mimetype="text/csv",
        headers={
            "Content-Disposition":
                "attachment; filename=live_network_metrics.csv"
        }
    )


@app.errorhandler(Exception)
def handle_error(error):
    return jsonify({
        "error": str(error)
    }), 500


if __name__ == "__main__":
    print()
    print("=" * 60)
    print("NETWORK CONGESTION INTELLIGENCE DASHBOARD")
    print("=" * 60)
    print(f"Project : {BASE_DIR}")
    print(f"Data    : {DATA_DIR}")
    print("Server  : http://127.0.0.1:5000")
    print("=" * 60)
    print()

    app.run(
        host="0.0.0.0",
        port=5000,
        debug=False,
        threaded=True
    )
