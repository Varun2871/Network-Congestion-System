        </div>
        <div class="kpi-note">Receive rate</div>
    </div>

    <div class="panel kpi">
        <div class="kpi-label">TX</div>
        <div id="tx" class="kpi-value">
            -- <span class="kpi-unit">Mbps</span>
        </div>
        <div class="kpi-note">Transmit rate</div>
    </div>

    <div class="panel kpi">
        <div class="kpi-label">Latency</div>
        <div id="latency" class="kpi-value">
            -- <span class="kpi-unit">ms</span>
        </div>
        <div class="kpi-note">Network RTT</div>
    </div>

    <div class="panel kpi">
        <div class="kpi-label">Jitter</div>
        <div id="jitter" class="kpi-value">
            -- <span class="kpi-unit">ms</span>
        </div>
        <div class="kpi-note">Latency variation</div>
    </div>

    <div class="panel kpi">
        <div class="kpi-label">Packet Loss</div>
        <div id="loss" class="kpi-value">
            -- <span class="kpi-unit">%</span>
        </div>
        <div class="kpi-note">Probe loss</div>
    </div>

</section>


<section class="two">

    <div class="panel">

        <div class="panel-head">
            <div class="panel-title">
                Live Traffic
            </div>

            <div class="panel-subtitle">
                RX / TX / total throughput
            </div>
        </div>

        <div class="panel-body">
            <canvas id="trafficChart" width="900" height="280"></canvas>
        </div>

    </div>


    <div class="panel">

        <div class="panel-head">
            <div class="panel-title">
                Congestion Intelligence
            </div>

            <div class="panel-subtitle">
                Current score and ML state
            </div>
        </div>

        <div class="panel-body intelligence">

            <div
