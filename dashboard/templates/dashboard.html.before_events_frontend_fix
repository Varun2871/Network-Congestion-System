<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Network Intelligence Center</title>

<style>
:root {
    --bg: #071018;
    --panel: #0d1923;
    --panel2: #101f2b;
    --border: #223746;
    --text: #e9f2f7;
    --muted: #8196a5;
    --cyan: #35d9ff;
    --green: #38df91;
    --yellow: #ffd166;
    --red: #ff5d73;
    --blue: #679cff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(53,217,255,.08),
            transparent 30%
        ),
        #071018;
    color: var(--text);
    font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;
}

header {
    height: 68px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    background: rgba(7,16,24,.95);
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-box {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: linear-gradient(
        135deg,
        var(--cyan),
        var(--blue)
    );
    color: #031018;
    font-weight: 900;
}

.title {
    font-size: 15px;
    font-weight: 800;
}

.subtitle {
    font-size: 10px;
    color: var(--muted);
    margin-top: 3px;
}

.live {
    color: var(--green);
    font-size: 11px;
    font-weight: 800;
}

main {
    max-width: 1650px;
    margin: auto;
    padding: 24px;
}

.hero {
    display: grid;
    grid-template-columns: 1.7fr .8fr;
    gap: 16px;
    margin-bottom: 16px;
}

.panel {
    background:
        linear-gradient(
            180deg,
            rgba(16,31,43,.96),
            rgba(10,21,30,.96)
        );
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 15px 40px rgba(0,0,0,.22);
}

.hero-main {
    padding: 25px;
}

.eyebrow {
    color: var(--cyan);
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1.6px;
}

h1 {
    font-size: 34px;
    margin: 8px 0;
}

.description {
    color: var(--muted);
    max-width: 850px;
    font-size: 13px;
    line-height: 1.6;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
}

.tag {
    border: 1px solid var(--border);
    background: rgba(255,255,255,.025);
    color: #bdccd5;
    padding: 7px 9px;
    border-radius: 6px;
    font-size: 10px;
}

.state {
    padding: 25px;
}

.state-label {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 800;
}

.state-value {
    font-size: 32px;
    font-weight: 900;
    margin-top: 12px;
}

.normal {
    color: var(--green);
}

.warning {
    color: var(--yellow);
}

.congested {
    color: var(--red);
}

.unknown {
    color: var(--muted);
}

.state-reason {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
    margin-top: 8px;
}

.kpis {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 16px;
}

.kpi {
    padding: 17px;
}

.kpi-label {
    color: var(--muted);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 800;
}

.kpi-value {
    font-size: 26px;
    font-weight: 900;
    margin-top: 10px;
}

.kpi-unit {
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
}

.kpi-note {
    color: #617886;
    font-size: 9px;
    margin-top: 6px;
}

.two {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
}

.panel-head {
    padding: 18px 20px 0;
}

.panel-title {
    font-size: 12px;
    font-weight: 800;
}

.panel-subtitle {
    color: var(--muted);
    font-size: 9px;
    margin-top: 4px;
}

.panel-body {
    padding: 18px 20px 20px;
}

canvas {
    width: 100%;
    height: 280px;
    display: block;
}

.chart-small {
    height: 230px;
}

.intelligence {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 25px;
    align-items: center;
}

.gauge {
    width: 160px;
    height: 160px;
    margin: auto;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
        conic-gradient(
            var(--cyan) 0deg,
            var(--cyan) var(--angle),
            #1c2c38 var(--angle),
            #1c2c38 360deg
        );
    position: relative;
}

.gauge:after {
    content: "";
    position: absolute;
    inset: 12px;
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--border);
}

.gauge-inner {
    position: relative;
    z-index: 2;
    text-align: center;
}

.score {
    font-size: 30px;
    font-weight: 900;
}

.score-label {
    color: var(--muted);
    font-size: 9px;
    text-transform: uppercase;
}

.probability {
    margin-bottom: 13px;
}

.prob-label {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    margin-bottom: 5px;
}

.track {
    height: 7px;
    background: #1c2c38;
    border-radius: 10px;
    overflow: hidden;
}

.fill {
    height: 100%;
    width: 0;
    transition: width .4s;
}

.fill-normal {
    background: var(--green);
}

.fill-warning {
    background: var(--yellow);
}

.fill-congested {
    background: var(--red);
}

.pipeline {
    display: grid;
    grid-template-columns: repeat(5,1fr);
    gap: 10px;
}

.step {
    padding: 15px;
    border: 1px solid var(--border);
    border-radius: 10px;
    min-height: 115px;
    background: rgba(255,255,255,.015);
}

.step-no {
    color: var(--cyan);
    font-size: 10px;
    font-weight: 900;
}

.step-title {
    font-weight: 800;
    font-size: 11px;
    margin-top: 10px;
}

.step-text {
    color: var(--muted);
    font-size: 9px;
    line-height: 1.5;
    margin-top: 5px;
}

.policy {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 10px;
}

.policy-card {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
}

.policy-card.active {
    border-color: var(--cyan);
    box-shadow: 0 0 25px rgba(53,217,255,.08);
}

.policy-name {
    font-size: 10px;
    font-weight: 900;
}

.policy-value {
    font-size: 23px;
    font-weight: 900;
    margin-top: 8px;
}

.policy-info {
    color: var(--muted);
    font-size: 9px;
    margin-top: 5px;
}

.terminal {
    background: #040a0e;
    border: 1px solid #1a2b37;
    border-radius: 9px;
    overflow: hidden;
}

.terminal-top {
    height: 32px;
    border-bottom: 1px solid #1a2b37;
    display: flex;
    align-items: center;
    padding: 0 10px;
    color: var(--muted);
    font-size: 9px;
}

pre {
    margin: 0;
    padding: 14px;
    height: 270px;
    overflow: auto;
    color: #a8d6b8;
    font-family: monospace;
    font-size: 10px;
    line-height: 1.55;
    white-space: pre-wrap;
}

.events {
    max-height: 300px;
    overflow: auto;
}

.event {
    padding: 10px;
    border-left: 3px solid var(--cyan);
    background: rgba(255,255,255,.02);
    margin-bottom: 7px;
    border-radius: 5px;
}

.event-time {
    color: var(--muted);
    font-family: monospace;
    font-size: 9px;
}

.event-text {
    font-size: 10px;
    margin-top: 4px;
}

.diagnostics {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 10px;
}

.diag {
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 9px;
}

.diag-label {
    color: var(--muted);
    font-size: 8px;
    text-transform: uppercase;
}

.diag-value {
    font-size: 11px;
    font-weight: 800;
    margin-top: 6px;
}

.ok {
    color: var(--green);
}

.bad {
    color: var(--red);
}

.footer {
    text-align: center;
    color: #536a78;
    font-size: 9px;
    padding: 25px 0;
}

@media(max-width:1100px) {
    .kpis {
        grid-template-columns: repeat(3,1fr);
    }

    .hero,
    .two {
        grid-template-columns: 1fr;
    }

    .pipeline {
        grid-template-columns: 1fr 1fr;
    }
}

@media(max-width:700px) {
    main {
        padding: 12px;
    }

    .kpis,
    .policy,
    .diagnostics {
        grid-template-columns: 1fr 1fr;
    }

    .intelligence {
        grid-template-columns: 1fr;
    }

    .pipeline {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">
        <div class="logo-box">NI</div>
        <div>
            <div class="title">Network Intelligence Center</div>
            <div class="subtitle">
                Intelligent congestion prediction & adaptive traffic management
            </div>
        </div>
    </div>

    <div id="connection" class="live">
        ● CONNECTING
    </div>
</header>

<main>

<section class="hero">

    <div class="panel hero-main">
        <div class="eyebrow">
            Enterprise Network Operations
        </div>

        <h1>
            Live Congestion Intelligence
        </h1>

        <div class="description">
            Real-time network telemetry, congestion assessment,
