                    ONLINE
                </div>
            </div>

            <div class="diag">
                <div class="diag-label">
                    Live Metrics
                </div>

                <div
                    id="diagMetrics"
                    class="diag-value"
                >
                    CHECKING
                </div>
            </div>

            <div class="diag">
                <div class="diag-label">
                    Controller
                </div>

                <div
                    id="diagController"
                    class="diag-value"
                >
                    CHECKING
                </div>
            </div>

            <div class="diag">
                <div class="diag-label">
                    Traffic Control
                </div>

                <div
                    id="diagTC"
                    class="diag-value"
                >
                    CHECKING
                </div>
            </div>

        </div>

    </div>

</section>


<div class="footer">
    Intelligent Live Network Congestion Prediction and
    Closed-Loop Adaptive Traffic Management System
</div>

</main>


<script>
"use strict";


const historyData = {
    labels: [],
    rx: [],
    tx: [],
    total: [],
    latency: [],
    jitter: [],
    loss: []
};


function byId(id) {
    return document.getElementById(id);
}


function num(value) {
    const n = Number(value);

    if (Number.isFinite(n)) {
        return n;
    }

    return 0;
}


function fmt(value, digits = 2) {
    return num(value).toFixed(digits);
}


function setText(id, value) {
    const el = byId(id);

    if (el) {
        el.textContent = value;
    }
}


function stateClass(state) {
    const value = String(state || "").toUpperCase();

    if (value === "NORMAL") return "normal";
    if (value === "WARNING") return "warning";
    if (value === "CONGESTED") return "congested";

    return "unknown";
}


function formatTime(value) {
    if (!value) {
        return "--";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
        return String(value);
    }

    return date.toLocaleTimeString();
}


async function getJSON(url) {
    const response = await fetch(
        url + "?_=" + Date.now(),
        {
            cache: "no-store"
        }
    );

    if (!response.ok) {
        throw new Error(
            url + " returned " + response.status
        );
    }

    return await response.json();
}


/* ============================================================
   SIMPLE CANVAS CHART
   ============================================================ */

function drawChart(canvasId, datasets, maxValue = null) {

    const canvas = byId(canvasId);

    if (!canvas) {
        return;
    }

    const ctx = canvas.getContext("2d");

    const width = canvas.width;
    const height = canvas.height;

    ctx.clearRect(0, 0, width, height);

    const padding = 42;

    const chartWidth =
        width - padding * 1.5;

    const chartHeight =
        height - padding * 1.4;

    let maximum = maxValue || 0;

    datasets.forEach(dataset => {
        dataset.data.forEach(value => {
            maximum = Math.max(
                maximum,
                num(value)
            );
        });
    });

    if (maximum <= 0) {
        maximum = 1;
    }

    maximum *= 1.15;

    ctx.strokeStyle = "#1e3442";
    ctx.lineWidth = 1;

    for (let i = 0; i <= 5; i++) {

        const y =
            padding +
            chartHeight -
            (chartHeight * i / 5);

        ctx.beginPath();
        ctx.moveTo(padding, y);
        ctx.lineTo(
            padding + chartWidth,
            y
        );
        ctx.stroke();

        ctx.fillStyle = "#627987";
        ctx.font = "10px Arial";

        ctx.fillText(
            (maximum * i / 5).toFixed(1),
            5,
            y + 3
        );
    }

    datasets.forEach(dataset => {

        if (dataset.data.length < 1) {
            return;
        }

        ctx.strokeStyle = dataset.color;
        ctx.lineWidth = 2;
        ctx.beginPath();

        dataset.data.forEach((value, index) => {

            const x =
                padding +
                (
                    chartWidth *
                    index /
                    Math.max(
                        dataset.data.length - 1,
                        1
                    )
                );

            const y =
                padding +
                chartHeight -
                (
                    chartHeight *
                    num(value) /
                    maximum
                );

            if (index === 0) {
                ctx.moveTo(x, y);
            } else {
                ctx.lineTo(x, y);
            }
        });

        ctx.stroke();
    });

    let legendX = padding;

    datasets.forEach(dataset => {

        ctx.fillStyle = dataset.color;

        ctx.fillRect(
            legendX,
            height - 22,
            12,
            3
        );

        ctx.fillStyle = "#91a5b2";
        ctx.font = "10px Arial";

        ctx.fillText(
            dataset.name,
            legendX + 17,
            height - 18
        );

        legendX +=
            65 +
            dataset.name.length * 5;
    });
}


/* ============================================================
   METRICS
   ============================================================ */

async function updateMetrics() {

    try {

        const data =
            await getJSON("/api/metrics");

        setText(
            "interface",
            data.interface || "eth0"
        );

        setText(
            "traffic",
            fmt(data.total_traffic_mbps) + " Mbps"
        );

        setText(
            "rx",
            fmt(data.rx_mbps) + " Mbps"
        );

        setText(
            "tx",
            fmt(data.tx_mbps) + " Mbps"
        );

        setText(
            "latency",
            fmt(data.latency_ms) + " ms"
        );

        setText(
            "jitter",
            fmt(data.jitter_ms) + " ms"
        );

        setText(
            "loss",
            fmt(data.packet_loss_percent) + " %"
        );

        const state =
            String(
                data.validated_state || "UNKNOWN"
            ).toUpperCase();

        const stateElement =
            byId("state");

        stateElement.textContent =
            state;

        stateElement.className =
            "state-value " +
            stateClass(state);

        setText(
            "prediction",
            String(
                data.ml_prediction || "--"
            ).toUpperCase()
        );

        setText(
            "reason",
            data.reason ||
            "Current state derived from live network telemetry."
        );

        let score =
            num(data.congestion_score);

        if (score <= 1) {
            score *= 100;
        }

        score =
            Math.max(
                0,
                Math.min(100, score)
            );

        setText(
            "score",
            Math.round(score) + "%"
        );

        byId("gauge").style.setProperty(
            "--angle",
            (score * 3.6) + "deg"
        );

        /*
         * The backend currently may not expose
         * probabilities. Keep the bars at zero
         * rather than inventing values.
         */

        const probabilities =
            data.probabilities || {};

        updateProbability(
            "Normal",
            probabilities.NORMAL ||
            probabilities.normal ||
            0
        );

        updateProbability(
            "Warning",
            probabilities.WARNING ||
            probabilities.warning ||
            0
        );

        updateProbability(
            "Congested",
            probabilities.CONGESTED ||
            probabilities.congested ||
            0
        );

        updatePolicies(
            data.policy,
            state
        );

        byId("diagMetrics").textContent =
            data.data_available
                ? "LIVE"
                : "WAITING";

        byId("diagMetrics").className =
            data.data_available
                ? "diag-value ok"
                : "diag-value";

        byId("diagController").textContent =
            data.controller_available
                ? "RUNNING"
                : "STANDBY";

        byId("diagController").className =
            data.controller_available
                ? "diag-value ok"
                : "diag-value";

        byId("connection").textContent =
            "● LIVE";

    } catch (error) {

        console.error(error);

        byId("connection").textContent =
            "● BACKEND ERROR";

        byId("connection").style.color =
            "#ff5d73";
    }
}


function updateProbability(name, value) {

    let percentage = num(value);

    if (percentage <= 1) {
        percentage *= 100;
    }

    percentage =
        Math.max(
            0,
            Math.min(100, percentage)
        );

    setText(
        "p" + name,
        percentage.toFixed(1) + "%"
    );

    const bar =
        byId(
            "bar" +
            name
        );

    if (bar) {
        bar.style.width =
            percentage + "%";
    }
}


/* ============================================================
   HISTORY
   ============================================================ */

async function updateHistory() {

    try {

        const historyResponse =
            await getJSON("/api/history");

        /*
         * The Flask API returns:
         *
         * {
         *     "history": [...]
         * }
         *
         * Accept both the current object format and a plain
         * array so the dashboard remains robust.
         */

        const rows =
            Array.isArray(historyResponse)
                ? historyResponse
                : (
                    Array.isArray(historyResponse.history)
                        ? historyResponse.history
                        : []
                );

        const recent =
            rows.slice(-45);

        historyData.labels =
            recent.map(
                row =>
                    formatTime(
                        row.timestamp
                    )
            );

        historyData.rx =
            recent.map(
                row =>
                    num(row.rx)
            );

        historyData.tx =
            recent.map(
                row =>
                    num(row.tx)
            );

        historyData.total =
            recent.map(
                row =>
                    num(row.traffic)
            );

        historyData.latency =
            recent.map(
                row =>
                    num(row.latency)
            );

        historyData.jitter =
            recent.map(
                row =>
                    num(row.jitter)
            );

        historyData.loss =
            recent.map(
                row =>
                    num(row.loss)
            );

        drawChart(
            "trafficChart",
            [
                {
                    name: "RX",
                    data: historyData.rx,
                    color: "#28b9ff"
                },
                {
                    name: "TX",
                    data: historyData.tx,
                    color: "#42e8a4"
                },
                {
                    name: "TOTAL",
                    data: historyData.total,
                    color: "#b48cff"
                }
            ]
        );

        drawChart(
            "qualityChart",
            [
                {
                    name: "Latency",
                    data: historyData.latency,
                    color: "#ffca5c"
                },
                {
                    name: "Jitter",
                    data: historyData.jitter,
                    color: "#ff6b81"
                }
            ]
        );

        /*
         * Keep a visible indication that historical telemetry
         * is actually being received.
         */

        const countElement =
            byId("historyCount");

        if (countElement) {
            countElement.textContent =
                rows.length +
                " live samples";
        }

    } catch (error) {

        console.error(
            "History update failed:",
            error
        );

    }
}

async function updateTC() {

    try {

        const data =
            await getJSON("/api/tc");

        setText(
            "tc",
            data.output ||
            "No tc information."
        );

        byId("diagTC").textContent =
            data.available
                ? "ACTIVE"
                : "UNAVAILABLE";

        byId("diagTC").className =
            data.available
                ? "diag-value ok"
                : "diag-value bad";

    } catch (error) {

        setText(
            "tc",
            "Unable to read tc information."
        );

        byId("diagTC").textContent =
            "ERROR";

        byId("diagTC").className =
            "diag-value bad";
    }
}


/* ============================================================
   EVENTS
   ============================================================ */

async function updateEvents() {

    try {

        const events =
            await getJSON("/api/events");

        const container =
            byId("events");

        if (!events.length) {

            container.innerHTML =
                `<div class="event">
                    <div class="event-text">
                        No controller events yet.
                        Start the closed-loop controller
                        to populate this stream.
                    </div>
                </div>`;

            return;
        }

        container.innerHTML =
            events
                .slice(-20)
                .reverse()
                .map(event => {

                    const type =
                        event.type ||
                        event.event ||
                        "EVENT";

                    const text =
                        event.reason ||
                        (
                            "ML: " +
                            (
                                event.ml_prediction ||
                                "--"
                            ) +
                            " | State: " +
                            (
                                event.validated_state ||
                                event.state ||
                                "--"
                            )
                        );

                    return `
                        <div class="event">
                            <div class="event-time">
                                ${formatTime(event.timestamp)}
                            </div>

                            <div class="event-text">
                                <strong>
                                    ${type}
                                </strong>
                                · ${text}
                            </div>
                        </div>
                    `;
                })
                .join("");

    } catch (error) {

        console.error(
            "Event error:",
            error
        );
    }
}


/* ============================================================
   REFRESH
   ============================================================ */

async function refresh() {

    await Promise.allSettled([
        updateMetrics(),
        updateHistory(),
        updateTC(),
        updateEvents()
    ]);
}


window.addEventListener(
    "load",
    async function() {

        /*
         * This guarantees that the browser
         * has a visible page even if the
         * backend has no data.
         */

        await refresh();

        setInterval(
            refresh,
            2000
        );
    }
);

</script>

